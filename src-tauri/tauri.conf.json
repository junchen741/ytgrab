{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YTGrab 音樂抓抓",
  "version": "0.1.1",
  "identifier": "app.ytgrab.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "YTGrab 音樂抓抓",
        "width": 900,
        "height": 740,
        "minWidth": 720,
        "minHeight": 600,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost https://i.ytimg.com; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/yt-dlp.exe": "bin/yt-dlp.exe",
      "binaries/ffmpeg.exe": "bin/ffmpeg.exe",
      "binaries/deno.exe": "bin/deno.exe",
      "resources/THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["TradChinese"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGMDE5MjAwMzk1REI1QkUKUldTK3RWMDVBSklCajgvd1hEUzVEZEtVWkIvTmlrQWxPbXdQZnFoQ3lIWVp5RHJXbVNmTUJ5TGcK",
      "endpoints": [
        "https://github.com/junchen741/ytgrab/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
